{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  // Tests, their fixtures and the repository's ESLint rules (src/lint) are not shipped; migrate.ts
  // and seed.ts are, because the container runs them on start.
  "exclude": ["src/**/*.test.ts", "src/**/*-fixtures.ts", "src/lint/**"]
}
