{
  "name": "@wings/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:embed": "node e2e/embed.mjs",
    "test:nginx": "node e2e/nginx-headers.mjs",
    "test:e2e:api": "pnpm --filter @wings/api exec tsx ../landing/e2e/api-server.ts",
    "wing-points": "node scripts/wing-points.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@wings/shared": "workspace:*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "5.1.0",
    "@fontsource/limelight": "5.1.0",
    "@fortawesome/fontawesome-free": "6.5.2",
    "@types/three": "^0.186.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
