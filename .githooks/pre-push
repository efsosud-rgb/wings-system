#!/bin/sh
# Refuses a direct push to develop, main or homologacao: those branches change only through a
# pull request with CI green and an independent review (docs/decisoes.md, 27/10/2026).
# Installed by scripts/instalar-hooks.sh. Git sends one line per ref: <local> <sha> <remote ref> <sha>.
status=0
while read -r _local _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/develop | refs/heads/main | refs/heads/homologacao)
      branch=${remote_ref#refs/heads/}
      echo "Push recusado: a branch '$branch' só recebe mudanças por pull request." >&2
      echo "Suba a sua branch (git push -u origin <sua-branch>) e abra o PR com: gh pr create --base develop" >&2
      echo "Regra do método de 28/10/2026 (docs/decisoes.md). Dúvida: fale com o Eric." >&2
      status=1
      ;;
  esac
done
exit $status
