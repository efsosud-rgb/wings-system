# Copy to .env for local development. Never commit the real .env.
# Staging and production values live in Coolify environment variables, not in this repo.

# --- API ---
NODE_ENV=development
API_PORT=3000

# --- Database (local dev container from docker-compose.dev.yml) ---
DATABASE_URL=postgresql://wings:wings_dev_only@127.0.0.1:5433/wings_system

# --- Secrets (generate real ones per environment; see docs/secrets.md in Phase 3) ---
# Session cookie signing key (32+ random bytes, base64)
SESSION_SECRET=
# AES-256-GCM key for CPF encryption (32 random bytes, base64).
# WARNING: losing this key makes stored CPFs unrecoverable.
CPF_ENCRYPTION_KEY=
# HMAC-SHA256 key for the CPF blind index (32 random bytes, base64). Must differ from CPF_ENCRYPTION_KEY.
CPF_INDEX_KEY=

# --- SMTP (Google Workspace, used from the invite/reset flow in a later phase) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public base URL used to build invite and password-reset links
APP_BASE_URL=http://localhost:5173

# --- WordPress (site da Wings): rascunhos de post criados pelo studio ---
# Senha de aplicativo do WordPress (Usuários > Perfil > Senhas de aplicativo),
# de um usuário que só escreve posts. Sem as três, a rota responde 503.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# Google Analytics 4 (Data API): numeric property id, and an OAuth refresh token
# (secret, scope analytics.readonly) granted through the Google Ads OAuth client
# (GOOGLE_ADS_CLIENT_ID/SECRET). The organisation blocks service account keys.
GA4_PROPERTY_ID=
GA4_REFRESH_TOKEN=
# RD Station CRM instance token (secret), read only, for the dashboard funnel.
RD_CRM_API_TOKEN=

# --- Tráfego pago: Meta e Google (nomes apenas; valores reais ficam no Coolify) ---
# ADS_WRITES_ENABLED só sobe com o aprovador presente, e desce logo depois.
ADS_WRITES_ENABLED=false
META_WRITE_TOKEN=
META_WRITE_ACCOUNT_ID=
# Pixel cujo evento Lead o conjunto de anúncios otimiza. Não é segredo.
META_PIXEL_ID=1116678872845520
# Volume montado para vídeos de anúncio (até 4 GB cada — grandes demais para o
# banco). Sem ele, as rotas de vídeo respondem 503, nunca um sucesso falso.
CREATIVE_VIDEO_DIR=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Traffic agent conversation (OpenRouter). Without the key the agent answers 503.
# AGENT_MODEL: anthropic/claude-sonnet-5 (default) or anthropic/claude-haiku-4.5
# AGENT_DAILY_USD: daily ceiling per employee, in US dollars (default 2)
OPENROUTER_API_KEY=
AGENT_MODEL=
AGENT_DAILY_USD=
# Insights e sugestões do dashboard (mesma infra, teto próprio em dólares por dia; padrão 1).
INSIGHTS_DAILY_USD=
# Cron (5 campos, horário de São Paulo) com que a tarefa agendada do Coolify roda
# ingest-cli. Só informa a tela ("próxima ingestão às…"); não agenda nada por si.
# Exemplo, de hora em hora: 0 * * * *
ADS_INGEST_CRON=
# Mesma ideia, para a segunda tarefa agendada: ingest-cli --reconcile-only.
# Exemplo, a cada 15 min: */15 * * * *
ADS_RECONCILE_CRON=

# External integrations (Kairogen). Key: openssl rand -base64 32, different from the CPF keys.
# KAIROGEN_CLIENT_ID only if dynamic client registration is refused.
INTEGRATIONS_ENCRYPTION_KEY=
KAIROGEN_CLIENT_ID=
# Media library volume. Falls back to CREATIVE_VIDEO_DIR/media.
MEDIA_DIR=

# Drive storage: an S3-compatible bucket (Cloudflare R2). With all four set, files
# live there and browsers use pre-signed addresses; otherwise the Drive uses
# MEDIA_DIR (development and tests). The bucket needs CORS: see docs/drive.md.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. R2's region is "auto", the default.
R2_REGION=
# Optional. Largest file the Drive takes, in bytes. Default 2147483648 (2 GB).
DRIVE_MAX_FILE_BYTES=
# Kairogen credit ceilings: per person per day, and for everyone per month.
KAIROGEN_DAILY_CREDITS_PER_USER=
KAIROGEN_MONTHLY_CREDITS=

# Other media providers (docs/integracoes/provedores-de-midia.md). Each is on
# when its variables are set. Every generation counts in reais estimated
# against MEDIA_MONTHLY_BRL (default 300), whichever provider ran it.
# Cloudflare Workers AI: free within a daily quota this system counts itself.
CF_ACCOUNT_ID=
CF_WORKERS_AI_TOKEN=
CF_WORKERS_AI_DAILY_IMAGES=
# Gemini API: free tier, with local per-day and per-minute counters.
GEMINI_API_KEY=
GEMINI_DAILY_IMAGES=
GEMINI_IMAGES_PER_MINUTE=
# Gemini images are paid per use (no free tier): true only once the Google project has billing.
GEMINI_BILLING_ENABLED=
GEMINI_USD_PER_IMAGE=
# Higgsfield: pay-per-use in USD; the prices are what an output is expected to cost.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_USD_PER_IMAGE=
HIGGSFIELD_USD_PER_VIDEO_SECOND=
# MoneyPrinterTurbo: our own service for short videos. Bearer only if it sits behind one.
MPT_BASE_URL=
MPT_API_KEY=
# Dollars to reais for the ledger (default 5.5); reais per Kairogen credit (default 0: already paid for).
BRL_PER_USD=
MEDIA_MONTHLY_BRL=
KAIROGEN_BRL_PER_CREDIT=

# Funil Sofia, parte 1 (docs/leads/intake.md). Each webhook is off until its
# secret is set: unconfigured, it answers 503. RD Station and Z-API carry the
# shared secret in the URL they are given (?secret=) or in X-Wings-Webhook-Secret;
# Meta signs the raw body with the app secret.
RD_STATION_WEBHOOK_SECRET=
ZAPI_WEBHOOK_SECRET=
META_APP_SECRET=
META_LEADGEN_VERIFY_TOKEN=
# TikTok Lead Ads (TikTok's webhook or Zapier): shared secret, 16+ characters; without it the route answers 503.
TIKTOK_LEADS_WEBHOOK_SECRET=
# Site form, CRM phase 1 T5 (docs/crm/fase1-operacao.md). Cloudflare Turnstile:
# the site key is public (the page shows it), the secret stays in the API; without
# the secret the form answers 503. Forwarding each submission to RD Marketing is
# a write to RD: off unless "true", and only Eric turns it on. The paid lead
# research (enrich_lead) for site-form leads is off unless "true" too.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SITE_FORM_RD_FORWARD_ENABLED=
SITE_FORM_RESEARCH_ENABLED=
# Token with leads_retrieval to read Lead Ads answers; falls back to META_WRITE_TOKEN (read-only use).
META_LEADS_ACCESS_TOKEN=
# With the key set, forms are read every 5 min even without the webhook; "false" turns that off.
META_LEADS_POLL=
# Page ids (comma-separated, not secret) to read besides the ones the key lists, for a key that lists none.
META_LEADS_PAGE_IDS=
# Meta Lead Ads → RD CRM copy during the transition (docs/leads/meta-lead-ads.md): on when RD_CRM_API_TOKEN is set; "false" turns it off.
META_LEADS_RD_COPY_ENABLED=
# TikTok Lead Ads → RD CRM copy: its own switch, OFF unless "true" (needs RD_CRM_API_TOKEN). Off in staging.
TIKTOK_LEADS_RD_COPY_ENABLED=
# Google Ads lead forms → Funil (docs/leads/formularios.md): the webhook key typed in Google Ads, 16+ chars.
GOOGLE_ADS_LEADS_WEBHOOK_KEY=
# Arrival checks of a lead's form fields: Instagram Business Discovery through Wings' account.
INSTAGRAM_DISCOVERY_ACCOUNT_ID=
INSTAGRAM_DISCOVERY_TOKEN=
# Site/Instagram/CNPJ checks on arrival; on unless "false" (WhatsApp is always checked, offline).
LEAD_CHECKS_ENABLED=
# CRM Fase 1: working hours (Mon–Fri 9h–18h São Paulo) for the first contact after a lead gets an owner; 1 when unset.
CRM_FIRST_CONTACT_SLA_HOURS=
# CRM e-mail to the lead: test (default, records only) or smtp
CRM_EMAIL_MODE=
# CRM automations cycle in the API process: "*/N * * * *" (minutes); every 5 when unset
CRM_AUTOMATIONS_CRON=
# Days a deal may sit in a stage before the panel warns (7 when unset; 0 = off)
CRM_STAGE_STUCK_DAYS=
# The Wings WhatsApp every tracked wa.me link opens, Expansão brands included (Sofia answers there):
# 55 + DDD + number, digits only. Not a secret. A brand's own WhatsApp is never used in a link.
WINGS_WHATSAPP_NUMBER=

# Worker: the enrich_lead job. Z-API (same instance as the API) reads the
# WhatsApp profile; Brave Search finds public LinkedIn/Instagram pages and is
# PAID per query (default US$ 0.005) under ENRICH_DAILY_USD (default 2) for
# the whole company; BrasilAPI is public. Unset, a step is skipped.
BRAVE_SEARCH_API_KEY=
ENRICH_SEARCH_USD_PER_QUERY=
ENRICH_DAILY_USD=
BRASILAPI_BASE_URL=

# Roadmap (docs/roadmap.md): daily progress report for the CEOs. The token is
# a GitHub fine-grained PAT, read-only, scoped to Contents+Metadata on this
# one repo only. Without it, roadmap-cli.js --generate fails loudly.
GITHUB_ROADMAP_TOKEN=
GITHUB_ROADMAP_REPO=
# Same pattern as ADS_WRITES_ENABLED: off in every environment until a human
# flips it. The 18:00 job always computes the report either way.
ROADMAP_REPORT_SEND_ENABLED=
