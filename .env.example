# Copy to .env for local development. Never commit the real .env.
# Staging and production values live in Coolify environment variables, not in this repo.

# --- API ---
NODE_ENV=development
API_PORT=3000

# --- Database (local dev container from docker-compose.dev.yml) ---
DATABASE_URL=postgresql://wings:wings_dev_only@127.0.0.1:5433/wings_system

# --- Secrets (generate real ones per environment; see docs/secrets.md in Phase 3) ---
# Session cookie signing key (32+ random bytes, base64)
SESSION_SECRET=
# AES-256-GCM key for CPF encryption (32 random bytes, base64).
# WARNING: losing this key makes stored CPFs unrecoverable.
CPF_ENCRYPTION_KEY=
# HMAC-SHA256 key for the CPF blind index (32 random bytes, base64). Must differ from CPF_ENCRYPTION_KEY.
CPF_INDEX_KEY=

# --- SMTP (Google Workspace, used from the invite/reset flow in a later phase) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public base URL used to build invite and password-reset links
APP_BASE_URL=http://localhost:5173

# --- WordPress (site da Wings): rascunhos de post criados pelo studio ---
# Senha de aplicativo do WordPress (Usuários > Perfil > Senhas de aplicativo),
# de um usuário que só escreve posts. Sem as três, a rota responde 503.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Tráfego pago: Meta e Google (nomes apenas; valores reais ficam no Coolify) ---
# ADS_WRITES_ENABLED só sobe com o aprovador presente, e desce logo depois.
ADS_WRITES_ENABLED=false
META_WRITE_TOKEN=
META_WRITE_ACCOUNT_ID=
# Pixel cujo evento Lead o conjunto de anúncios otimiza. Não é segredo.
META_PIXEL_ID=1116678872845520
# Volume montado para vídeos de anúncio (até 4 GB cada — grandes demais para o
# banco). Sem ele, as rotas de vídeo respondem 503, nunca um sucesso falso.
CREATIVE_VIDEO_DIR=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Traffic agent conversation (OpenRouter). Without the key the agent answers 503.
# AGENT_MODEL: anthropic/claude-sonnet-5 (default) or anthropic/claude-haiku-4.5
# AGENT_DAILY_USD: daily ceiling per employee, in US dollars (default 2)
OPENROUTER_API_KEY=
AGENT_MODEL=
AGENT_DAILY_USD=

# External integrations (Kairogen). Key: openssl rand -base64 32, different from the CPF keys.
# KAIROGEN_CLIENT_ID only if dynamic client registration is refused.
INTEGRATIONS_ENCRYPTION_KEY=
KAIROGEN_CLIENT_ID=
# Media library volume. Falls back to CREATIVE_VIDEO_DIR/media.
MEDIA_DIR=

# Drive storage: an S3-compatible bucket (Cloudflare R2). With all four set, files
# live there and browsers use pre-signed addresses; otherwise the Drive uses
# MEDIA_DIR (development and tests). The bucket needs CORS: see docs/drive.md.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. R2's region is "auto", the default.
R2_REGION=
# Optional. Largest file the Drive takes, in bytes. Default 2147483648 (2 GB).
DRIVE_MAX_FILE_BYTES=
# Kairogen credit ceilings: per person per day, and for everyone per month.
KAIROGEN_DAILY_CREDITS_PER_USER=
KAIROGEN_MONTHLY_CREDITS=
